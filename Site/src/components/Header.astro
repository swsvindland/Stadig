---
import Logo from "./Logo.astro";
import { nav, brand } from "../content/site";
import { cleanPath } from "../lib/path";
const path = cleanPath(Astro.url.pathname);
// "Get the apps" goes to the buttons on this page if it has them, else the home page's.
const get = path === "/" || path === "/lift" || path === "/macro" ? "#get" : "/#get";
const current = (href: string) => (href === path ? "page" : undefined);
---
<header class="wrap nav">
  <a class="brand" href="/" aria-label={`${brand.name} home`}><Logo /><span aria-hidden="true">{brand.name}</span></a>
  <nav class="links" aria-label="Main">
    {nav.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
  </nav>
  <div class="navend">
    <details class="menu">
      <summary class="navbtn">Menu</summary>
      <nav aria-label="Main">
        <a href="/" aria-current={current("/")}>Home</a>
        {nav.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
      </nav>
    </details>
    <a class="navbtn" href={get}>Get the apps</a>
  </div>
</header>
