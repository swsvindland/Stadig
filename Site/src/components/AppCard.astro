---
import type { App } from "../content/site";
const { app } = Astro.props as { app: App };
---
<a class={`appcard accent-${app.accent}`} href={`/${app.slug}`}>
  <span class="top"><span class="dot"></span><span class="eyebrow" style="margin:0">{app.short}</span></span>
  <h3>{app.name}</h3>
  <p>{app.oneLiner}</p>
  <span class="plat muted">{app.platforms.join(" · ")}</span>
</a>
<style>
  .appcard { display: flex; flex-direction: column; gap: 0.5rem; text-decoration: none; background: var(--bg-2); border: 1px solid var(--line); border-radius: 1.25rem; padding: 1.6rem; transition: border-color 0.15s, transform 0.15s; }
  .appcard:hover { border-color: var(--accent); transform: translateY(-2px); }
  .top { display: inline-flex; align-items: center; gap: 0.5rem; }
  h3 { font-size: 1.5rem; margin: 0.4rem 0 0; }
  p { margin: 0; color: var(--ink-2); flex: 1; }
  .plat { font-size: 0.85rem; margin-top: 0.6rem; }
</style>
