---
import Base from "../../layouts/Base.astro";
import Rule from "../../components/Rule.astro";
// Where api/feedback.ts sends someone once their report is filed.
---
<Base title="Sent" description="Your report reached Stadig." noindex>
  <section class="wrap page" aria-labelledby="sent-title">
    <Rule label="Support" />
    <div class="intro">
      <h1 class="h1" id="sent-title">Got it. Thank you.</h1>
      <div class="stack">
        <p class="lede">Your report is in, and it will be read. If you left an email, a reply comes there.</p>
        <div class="cta">
          <a class="btn" href="/">Back to the start</a>
          <a class="more" href="/support">Send another <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        </div>
      </div>
    </div>
  </section>
</Base>
