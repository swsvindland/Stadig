---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import { brand, faq } from "../content/site";
// The answers are plain text (they're the JSON-LD too), so the repository's address in one is
// turned into a link here.
const sourceHost = brand.source.replace(/^https:\/\//, "");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Base title="FAQ" description={`Questions about ${brand.name}, Stadig Lift and Stadig Macro: what they cost, the six scores, offline use, privacy, devices and the ideas behind them.`} jsonLd={jsonLd}>
  <section class="wrap page" aria-labelledby="faq-title">
    <Rule label="FAQ" aside={`${faq.length} questions`} />
    <div class="intro">
      <h1 class="h1" id="faq-title">Questions, answered plainly.</h1>
      <p class="lede">Something else, or something broken? Tell us on the <a class="inline-link" href="/support">support page</a>.</p>
    </div>
    <div class="qa">
      {faq.map((f, i) => (
        <details open={i < 4}>
          <summary>{f.q}</summary>
          <p class="lede ans">
            {f.a.split(sourceHost).map((part, j) => (j === 0 ? part : <><a class="inline-link" href={brand.source} rel="noopener">{sourceHost}</a>{part}</>))}
          </p>
        </details>
      ))}
    </div>
  </section>
</Base>
