---
import Base from "../layouts/Base.astro";
import StoreButton from "../components/StoreButton.astro";
import { brand, apps } from "../content/site";

export function getStaticPaths() {
  return apps.map((app) => ({ params: { app: app.slug }, props: { app } }));
}
const { app } = Astro.props;
const others = apps.filter((a) => a.slug !== app.slug);
const systems: Record<string, string> = { "Apple Watch": "watchOS", Mac: "macOS", "Apple Vision Pro": "visionOS" };
const os = app.platforms.map((p) => systems[p] ?? "iOS").filter((v, i, a) => a.indexOf(v) === i).join(", ");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: app.name,
    url: `${brand.domain}/${app.slug}`,
    applicationCategory: app.category,
    operatingSystem: os,
    description: app.description,
    author: { "@id": `${brand.domain}/#org` },
    offers: { "@type": "Offer", price: "29.99", priceCurrency: "USD", description: "Free for 21 days, then $29.99 once or $2.99 a month. Logging, export and backup are free." },
    featureList: app.features.map((f) => f.title),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: brand.name, item: brand.domain },
      { "@type": "ListItem", position: 2, name: app.name, item: `${brand.domain}/${app.slug}` },
    ],
  },
];
---
<Base title={`${app.name}: ${app.oneLiner}`} description={app.description} jsonLd={jsonLd} ogImage={`/og-${app.slug}.png`} titleSuffix={false}>
  <article class={`accent-${app.accent}`}>
    <section class="hero wrap">
      <p class="eyebrow"><span class="dot"></span> {app.name} · {app.platforms.join(", ")}</p>
      <h1>{app.headline}</h1>
      <p class="lede">{app.description}</p>
      <div class="ctas" id="get"><StoreButton app={app} /></div>
      <p class="muted small">{app.free}</p>
    </section>

    <section class="wrap">
      <div class="grid two">
        <div><p class="eyebrow">The idea</p><h2>{app.oneLiner}</h2></div>
        <div>{app.intro.map((p) => <p class="lede">{p}</p>)}</div>
      </div>
    </section>

    <section class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>From first open to steady progress.</h2>
      <ol class="steps" style="margin-top:2rem">
        {app.how.map((h) => <li><h3>{h.title}</h3><p>{h.body}</p></li>)}
      </ol>
    </section>

    <section class="wrap">
      <p class="eyebrow">What's in it</p>
      <h2>{app.name} in detail.</h2>
      <div class="grid three" style="margin-top:2rem">
        {app.features.map((f) => <div class="card"><h3>{f.title}</h3><p>{f.body}</p></div>)}
      </div>
    </section>

    <section class="wrap">
      <p class="eyebrow">The other {brand.name} apps</p>
      <div class="grid two">
        {others.map((o) => <a class={`card link accent-${o.accent}`} href={`/${o.slug}`}><span class="dot"></span><h3>{o.name}</h3><p>{o.oneLiner}</p></a>)}
      </div>
    </section>
  </article>
</Base>
<style>
  .hero { padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem); }
  .hero h1 { max-width: 16ch; }
  .eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; }
  .ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 1.5rem 0 1rem; }
  .small { font-size: 0.9rem; max-width: 50ch; }
  .link { text-decoration: none; display: block; }
  .link:hover { border-color: var(--accent); }
  .link h3 { margin-top: 0.6rem; }
  .link p { color: var(--ink-2); }
</style>
