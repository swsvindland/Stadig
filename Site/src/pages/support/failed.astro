---
import Base from "../../layouts/Base.astro";
import Rule from "../../components/Rule.astro";
import { brand } from "../../content/site";
// Where api/feedback.ts sends someone when their report couldn't be filed. The site has no script,
// so the way back to what they wrote is the browser's own Back, which keeps a form's contents.
---
<Base title="Not sent" description="Your report couldn't be sent." noindex>
  <section class="wrap page" aria-labelledby="failed-title">
    <Rule label="Support" />
    <div class="intro">
      <h1 class="h1" id="failed-title">That didn't go through.</h1>
      <div class="stack">
        <p class="lede">
          Nothing was sent. Go back with your browser's Back button, which keeps what you wrote, and try again in a minute, or send the same thing
          to <a class="inline-link" href={`mailto:${brand.email}`}>{brand.email}</a>.
        </p>
        <div class="cta">
          <a class="btn" href={`mailto:${brand.email}`}>Write instead</a>
          <a class="more" href="/support">Start again <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        </div>
      </div>
    </div>
  </section>
</Base>
