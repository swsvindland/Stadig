---
import Logo from "./Logo.astro";
import Ticks from "./Ticks.astro";
import { brand, apps } from "../content/site";
---
<footer class="wrap foot">
  <Ticks />
  <div class="footgrid">
    <div class="footcol" style="gap:10px">
      <a class="brand" href="/" aria-label={`${brand.name} home`}><Logo /><span aria-hidden="true">{brand.name}</span></a>
      <p class="fine">{brand.pronunciation}. {brand.meaning}<span class="block">Made by {brand.publisher}.</span></p>
    </div>
    <nav class="footcol" aria-label="Apps">
      <span class="eye">Apps</span>
      {apps.map((a) => <a href={`/${a.slug}`}>{a.name}</a>)}
    </nav>
    <nav class="footcol" aria-label={brand.name}>
      <span class="eye">{brand.name}</span>
      <a href="/principles">Principles</a>
      <a href="/faq">FAQ</a>
      <a href="/support">Support</a>
      <a href="/privacy">Privacy</a>
      <a href={`mailto:${brand.email}`}>{brand.email}</a>
    </nav>
    <nav class="footcol" aria-label="For machines">
      <span class="eye">For machines</span>
      <a href="/llms.txt">llms.txt</a>
      <a href="/llms-full.txt">llms-full.txt</a>
      <a href="/sitemap-index.xml">Sitemap</a>
    </nav>
  </div>
  <p class="fine" style="max-width:none">© {new Date().getFullYear()} {brand.publisher}. Apple, iPhone, iPad, Mac, Apple Vision Pro, Apple Watch and App Store are trademarks of Apple Inc.</p>
</footer>
