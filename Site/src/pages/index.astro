---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import BigRuler from "../components/BigRuler.astro";
import Reading from "../components/Reading.astro";
import Figure from "../components/Figure.astro";
import StoreButton from "../components/StoreButton.astro";
import ScoreShape from "../components/ScoreShape.astro";
import Free from "../components/Free.astro";
import { brand, apps, appBySlug, homeFigures, macroFacts, scores, scoreRows, different, everything, trendTone } from "../content/site";

const lift = appBySlug("lift");
const macro = appBySlug("macro");
const strength = scores.find((s) => s.name === "Strength")!;
const appName = { lift: "Lift", macro: "Macro" } as const;
const jsonLd = apps.map((a) => ({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: a.name,
  url: `${brand.domain}/${a.slug}`,
  applicationCategory: a.category,
  operatingSystem: "iOS, iPadOS, macOS, visionOS, watchOS",
  description: a.description,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@id": `${brand.domain}/#org` },
}));
---
<Base title={`${brand.name}: ${brand.tagline}`} description={brand.description} jsonLd={jsonLd} titleSuffix={false}>
  <section class="wrap hero" aria-labelledby="hero-title">
    <div class="rulerow">
      <span class="eye">{apps.map((a) => a.name).join(" · ")}</span>
      <span class="eye wide">{brand.platforms.join(" · ")}</span>
    </div>
    <h1 class="h1" id="hero-title">{brand.tagline}</h1>
    <div class="heromid">
      <div class="herocopy">
        <p class="lede">{brand.lede}</p>
        <div id="get" class="cta">{apps.map((a) => <StoreButton app={a} />)}</div>
        <p class="fine">{brand.free}</p>
      </div>
      <Reading value={strength.value} name={strength.name} trend="Rising" flip label={`A sample reading: Strength ${strength.value}, rising, 3 points to Intermediate.`}>
        3 points to Intermediate.
      </Reading>
    </div>
    <BigRuler value={strength.value} />
  </section>

  <section class="wrap sec lift" id="lift" aria-labelledby="lift-title">
    <Rule label={lift.name} aside={lift.short} dot="var(--lift)" />
    <div class="head">
      <h2 class="h2" id="lift-title">{lift.headline}</h2>
      <div class="headcopy">
        <p class="lede">{lift.home.lede}</p>
        <div class="cta">
          <StoreButton app={lift} />
          <a class="more" href="/lift">How Stadig Lift works <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        </div>
      </div>
    </div>
    <div class="strip">{homeFigures.lift.map((f) => <Figure fig={f} />)}</div>
  </section>

  <section class="wrap sec macro" id="macro" aria-labelledby="macro-title">
    <Rule label={macro.name} aside={macro.short} dot="var(--macro)" />
    <div class="head">
      <h2 class="h2" id="macro-title">{macro.headline}</h2>
      <div class="headcopy">
        <p class="lede">{macro.home.lede}</p>
        <div class="cta">
          <StoreButton app={macro} />
          <a class="more" href="/macro">How Stadig Macro works <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        </div>
      </div>
    </div>
    <div class="duo">
      <div class="strip pair">
        {homeFigures.macro.map((f, i) => <Figure fig={f} big low={i === 1} />)}
      </div>
      <ul class="facts">
        {macroFacts.map((x) => (
          <li class="fact">
            <span class="fn">{x.n}<span class="unit">{x.unit}</span></span>
            <p class="lede">{x.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="paper" id="scores" aria-labelledby="scores-title">
    <div class="wrap sec top">
      <Rule label="The scores" aside="Sample scores, as the apps show them" />
      <div class="headone">
        <h2 class="h2" id="scores-title">Six scores. None of them move because you opened the app.</h2>
        <p class="lede">Each one is out of 100 and comes from something you can check: a lift, a tape measure, a heart-rate benchmark, a month of the plan kept. No XP and no streaks. Each score comes with the next thing that moves it.</p>
      </div>
      <div class="table">
        <div class="row rowhead" aria-hidden="true">
          <span class="eye">Score</span><span class="eye">Measured by</span><span class="eye">0 to 100 · what to do next</span><span class="eye d">Trend</span>
        </div>
        <ul aria-label="The six scores">
          {scoreRows.map((s) => (
            <li class="row">
              <span class="n">{s.value}</span>
              <div class="nm">
                <div class="rowname">
                  <h3 class="h4">{s.name}</h3>
                  <span class="chip">
                    {s.apps.map((a) => <i style={`background:var(--${a})`}></i>)}
                    {s.apps.map((a) => appName[a]).join(" + ")}
                  </span>
                </div>
                <p class="small">{s.source}</p>
              </div>
              <div class="g">
                {s.split ? (
                  <div class="gauges" aria-hidden="true">
                    {s.split.map((p) => <div class="gauge" style={`--v:${p.value};--c:var(--${p.app})`}></div>)}
                  </div>
                ) : (
                  <div class="gauge" aria-hidden="true" style={`--v:${s.value};--c:var(--${s.apps[0]})`}></div>
                )}
                <span class="next">{s.next}</span>
              </div>
              <span class={`d ${trendTone[s.trend]}`}><span class="sr">Trend: </span>{s.trend}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="both">
        <figure class="shape">
          <ScoreShape scores={scores} />
          <figcaption class="legend" aria-hidden="true">
            <span><i style="background:var(--lift)"></i>Stadig Lift</span>
            <span><i style="background:var(--macro)"></i>Stadig Macro</span>
            <span><i style="background:var(--text)"></i>Both</span>
          </figcaption>
        </figure>
        <div class="stack">
          <span class="eye">Your shape</span>
          <h3 class="h3"><span class="block">Six scores, one figure.</span><span class="block">It grows where you do the work.</span></h3>
          <p class="lede">Each axis is one of the rulers above. Stadig Lift measures Strength, Physique, Endurance and Agility, and the training half of Discipline. Stadig Macro measures Vitality and the nutrition half.</p>
          <p class="lede">One app draws its own scores. Set up both and each app draws all six, every score labelled with the app that measures it.</p>
          <div class="tally">
            <div><span class="fn" style="color:var(--lift)">4½</span><span class="fine">scores from Stadig Lift</span></div>
            <div><span class="fn" style="color:var(--macro)">1½</span><span class="fine">scores from Stadig Macro</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap sec top" id="different" aria-labelledby="different-title">
    <Rule label="How it's different" />
    <h2 class="h2" id="different-title" style="max-width:15em">A tracker tells you what happened. These tell you what to do.</h2>
    <ul class="difflist">
      {different.map((d) => <li class="diff"><h3 class="h3">{d.title}</h3><p class="lede">{d.body}</p></li>)}
    </ul>
  </section>

  <Free aside="Both apps" title="Everything in both apps" items={everything} legend lede="Both apps are free, every part of them: the plans, the adaptive targets, deloads and life modes. No account, and no ads." />

  <section class="wrap finale" aria-labelledby="close-title">
    <Rule label={`${brand.name} · ${brand.pronunciation} · ${brand.meaning.replace(/\.$/, "")}`} />
    <div class="closerow">
      <h2 class="h1 close" id="close-title"><span class="block">Find your number.</span><span class="block">Then move it.</span></h2>
      <div class="stack">
        <div class="cta stacked">{apps.map((a) => <StoreButton app={a} />)}</div>
        <p class="fine">{brand.free}</p>
      </div>
    </div>
    <BigRuler />
  </section>
</Base>
