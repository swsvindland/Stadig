---
import Logo from "./Logo.astro";
import { nav, brand } from "../content/site";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="wrap">
  <a class="home" href="/" aria-label={`${brand.name} home`}><Logo /> <span>{brand.name}</span></a>
  <nav aria-label="Main">
    {nav.map((n) => <a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a>)}
  </nav>
</header>
<style>
  header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.1rem; flex-wrap: wrap; }
  .home { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 700; font-size: 1.15rem; text-decoration: none; letter-spacing: -0.02em; }
  nav { display: flex; gap: 0.2rem 1.2rem; flex-wrap: wrap; font-size: 0.95rem; }
  nav a { text-decoration: none; color: var(--ink-2); padding: 0.25rem 0; }
  nav a:hover, nav a[aria-current="page"] { color: var(--ink); }
</style>
